; 新手教程关(v0.69 tutorial 波):四拍阶梯教「移动/跳·置换/召回·冲刺」
; 与首个机关(加速门)。不登记 SCENES/ACTS(level_data.gd 契约:存档下标
; 不得插删);入口唯一 = GameFlow.TUTORIAL_SCENE 常量路径,ui 波菜单钮
; 按此路径守卫。单屏单意、首屏无惩罚:出生段 0-1000 纯平地。
;   拍1 移动 0-1000 平地  拍2 跳 1000-2200(200/400px 缺口,二段跳)
;   拍3 冲刺·召回 2200-3500(600px 断口,记录点接应)
;   拍4 加速门 3500-4100 → 700px 大断口 → 终点门
[gd_scene format=4]

[ext_resource type="Script" path="res://scripts/world/native_level.gd" id="1_nl"]
[ext_resource type="TileSet" path="res://data/tiles/native_tileset.tres" id="2_ts"]
[ext_resource type="PackedScene" path="res://scenes/world/spawn_marker.tscn" id="3_spn"]
