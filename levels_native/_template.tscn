; 关卡模板(原生作关脚手架,levels.md §0):新关卡 = 复制本文件改名
; <场名>.tscn,再按 native_level.gd 摆放约定补 Spawn<N> / 机关 / 门 /
; 提示 / 记录点实例。本模板不登记 LevelData.SCENES,不会进战役目录。
[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/world/native_level.gd" id="1"]
[ext_resource type="TileSet" path="res://data/tiles/native_tileset.tres" id="2"]

[node name="LevelRoot" type="Node2D"]
script = ExtResource("1")
level_name = "新关"
intro_text = "第一行教操作,第二行教原理。"
level_size = Vector2(3600, 2000)
[node name="Decor" type="TileMapLayer" parent="."]
tile_set = ExtResource("2")
[node name="Solid" type="TileMapLayer" parent="."]
z_index = 1
tile_set = ExtResource("2")
[node name="Spawn0" type="Marker2D" parent="."]
position = Vector2(300, 1275)
