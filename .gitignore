# ===== Godot =====
# 编辑器缓存(导入产物、shader 缓存等,启动自动重建)
.godot/
# Android 构建模板与 gradle 产物
/android/
.gradle/

# ===== 本地构建与开发产物(不推送) =====
# 导出产物(exe / pck / dll),用 export_presets.cfg 随时可再导出
build/
# 开发截图(各版本迭代,.shots / .shots_vNN)
.shots*/
# 构建产物扩展名兜底:防 apk / aab 被误落到 build/ 之外时混入提交
# (本项目日常导出 Android debug apk,误提交一次就是几十 MB)
*.apk
*.aab
*.idsig

# ===== 凭据与密钥(绝不入库) =====
# Godot 导出凭据(Android keystore 密码等,导出对话框「保存凭据」时生成)
export_credentials.cfg
*.keystore
*.jks

# ===== 第三方插件(不入库,按 README「第三方插件」自行安装) =====
# 例外:第一方编辑器插件 editor_kit(机关坞)随库发布
addons/*
!addons/editor_kit

# ===== gode TS 工具链产物 =====
.gode/
node_modules/

# ===== 系统与编辑器杂物 =====
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# ===== Windows 临时锁文件(导出/插件覆盖被占用文件时产生,如 ~libgode_runtime.dll~RF*.TMP) =====
~*
*.tmp

# ===== Python 工具链杂物(tools/*.py) =====
__pycache__/
*.pyc
*.log

# AI 助手工作区目录(skills/工作流草稿等,机器本地,不入游戏仓库)
.zcode/

# ===== 兄弟仓库(独立 .git,不入本库) =====
speed-dev/
# 像素回归基线 / 对比目录(基线 .base_*,对比 .mNN)
/.base_*/
/.m[0-9]*/

# ===== ZCode 工作区工具残留 =====
.zcodeignore
